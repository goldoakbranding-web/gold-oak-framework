# Public production origin. Set this before the production build.
NEXT_PUBLIC_SITE_URL=

# Lead email delivery through Resend.
# The sender is configured in server code and uses the verified cmroofingwi.com domain.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=

# Optional SMS notification through Twilio.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LEAD_RECIPIENT_PHONE=+19207890700

# A form submission is acknowledged only after Resend accepts the notification email.
# The application does not include database persistence;
# add an external datastore/queue if durable lead storage is required.
