# Public production origin. Set this before the production build.
NEXT_PUBLIC_SITE_URL=

# Lead email delivery (Resend is the recommended primary provider).
# LEAD_FROM_EMAIL must use a sender/domain verified with the selected provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_RECIPIENT_EMAIL=cmroofing28@gmail.com

# SendGrid can be used instead of Resend.
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# LEAD_FROM_EMAIL=

# Optional SMS notification through Twilio.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LEAD_RECIPIENT_PHONE=+19207890700

# A form submission is acknowledged only after at least one configured provider
# accepts the notification. The application does not include database persistence;
# add an external datastore/queue if durable lead storage is required.
